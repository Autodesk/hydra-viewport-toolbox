#!/usr/bin/env bash
#
# pre-push hook — local fast-feedback builds before pushing a branch.
#
# Runs configure + build for the lean preset set on every push to a non-main
# branch, plus ctest for the presets listed in TEST_PRESETS (asan). Tag pushes,
# branch deletions, and pushes to main are skipped. Full validation across all
# presets/platforms remains CI's job.
#
# Install (once per clone):  git config core.hooksPath .githooks
# Bypass once:              git push --no-verify

set -uo pipefail

# Lean preset set — fast feedback on the compilers most likely to catch
# distinct issues (Clang debug + Clang ASan). Add presets here as needed;
# Vulkan presets require the Vulkan SDK to be installed locally.
PRESETS=(debug asan)

# Presets that also run ctest after building. Tests need a GPU/display, so
# keep this list short — the hook is for fast pre-push feedback, not full
# validation. Space-separated.
TEST_PRESETS="asan"

# Windows (Git for Windows / MSYS / Cygwin): the sanitizer presets do not
# exist there — their `condition` in CMakePresets.json is Linux/macOS only —
# so trim them or every push fails at the configure step.
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        PRESETS=(debug)
        TEST_PRESETS=""
        ;;
esac

# Branches that never trigger the hook (not PR branches).
PROTECTED_REFS="refs/heads/main refs/heads/master"

should_run=0
while read -r local_ref local_sha remote_ref remote_sha; do
    # Only branch pushes trigger builds; skip tags.
    case "$remote_ref" in
        refs/heads/*) ;;
        *) continue ;;
    esac

    # Skip branch deletions.
    if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
        continue
    fi

    # Skip pushes to protected branches.
    case " $PROTECTED_REFS " in
        *" $remote_ref "*) continue ;;
    esac

    should_run=1
done

if [ "$should_run" -eq 0 ]; then
    exit 0
fi

for preset in "${PRESETS[@]}"; do
    echo "pre-push: configuring preset '$preset'"
    if ! cmake --preset "$preset"; then
        echo "pre-push: configure failed for preset '$preset' — push aborted" \
            "(bypass with: git push --no-verify)" >&2
        exit 1
    fi

    echo "pre-push: building preset '$preset'"
    if ! cmake --build --preset "$preset"; then
        echo "pre-push: build failed for preset '$preset' — push aborted" \
            "(bypass with: git push --no-verify)" >&2
        exit 1
    fi

    case " $TEST_PRESETS " in
        *" $preset "*)
            echo "pre-push: running tests for preset '$preset'"
            if ! ctest --preset "$preset"; then
                echo "pre-push: tests failed for preset '$preset' — push aborted" \
                    "(bypass with: git push --no-verify)" >&2
                exit 1
            fi
            ;;
    esac
done

echo "pre-push: all lean presets passed"
exit 0
