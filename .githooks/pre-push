#!/usr/bin/env bash
#
# pre-push hook — local fast-feedback builds before pushing a branch.
#
# Runs configure + build for the lean preset set on every push to a non-main
# branch, plus How-to tests (howTo.*) for the presets listed in TEST_PRESETS
# (asan, ubsan) — run as a single hvt_test process, not through ctest. Tag
# pushes, branch deletions, and pushes to main are skipped. Full validation
# across all presets/platforms remains CI's job.
#
# Builds always target the commit(s) being pushed (local_sha). If the current
# checkout or uncommitted edits do not match that commit, a temporary detached
# worktree is used so the hook never validates the wrong tree (it reuses the
# main checkout's vcpkg clone, since worktrees do not populate submodules).
#
# Run by hand with no arguments to validate HEAD.
#
# Install (once per clone):  git config core.hooksPath .githooks
# Bypass once:              git push --no-verify

set -uo pipefail

# Lean preset set — fast feedback across a debug build and the sanitizer
# presets. Add presets here as needed; Vulkan presets require the Vulkan SDK
# to be installed locally.
PRESETS=(debug asan ubsan)

# Presets that also run How-to tests after building. Tests need a GPU/display,
# so keep this list short — the hook is for fast pre-push feedback, not full
# validation. Space-separated.
TEST_PRESETS="asan ubsan"

# GTest filter for the pre-push test subset (see test/howTos/ and docs/testing.md).
TEST_GTEST_FILTER='howTo.*'

# Set HVT_PRE_PUSH_SKIP_TESTS=1 to build only — e.g. on a headless machine
# with no GPU/display, where the How-to tests cannot run.
SKIP_TESTS="${HVT_PRE_PUSH_SKIP_TESTS:-0}"

# Windows (Git for Windows / MSYS / Cygwin): the sanitizer presets do not
# exist there — their `condition` in CMakePresets.json is Linux/macOS only —
# so trim them or every push fails at the configure step.
case "$(uname -s)" in
    MINGW*|MSYS*|CYGWIN*)
        PRESETS=(debug)
        TEST_PRESETS=""
        ;;
esac

# Branches that never trigger the hook (not PR branches).
PROTECTED_REFS="refs/heads/main refs/heads/master"

ZERO_SHA="0000000000000000000000000000000000000000"

repo_root=$(git rev-parse --show-toplevel)
git_dir=$(git rev-parse --git-dir)

# Worktree currently in use; removed by the EXIT trap so that failures,
# Ctrl-C and SIGTERM never leave a stale checkout behind.
wt=""

push_shas=()

# Git always passes <remote> <url>. With no arguments the script was run by
# hand (e.g. by an agent that cannot set core.hooksPath), so there are no ref
# lines on stdin — validate the current HEAD instead of silently passing.
if [ $# -eq 0 ]; then
    push_shas+=("$(git rev-parse HEAD)")
else
    while read -r local_ref local_sha remote_ref remote_sha; do
        # Only branch pushes trigger builds; skip tags.
        case "$remote_ref" in
            refs/heads/*) ;;
            *) continue ;;
        esac

        # Skip branch deletions.
        if [ "$local_sha" = "$ZERO_SHA" ]; then
            continue
        fi

        # Skip pushes to protected branches.
        case " $PROTECTED_REFS " in
            *" $remote_ref "*) continue ;;
        esac

        duplicate=0
        if [ "${#push_shas[@]}" -gt 0 ]; then
            for existing in "${push_shas[@]}"; do
                if [ "$existing" = "$local_sha" ]; then
                    duplicate=1
                    break
                fi
            done
        fi
        if [ "$duplicate" -eq 0 ]; then
            push_shas+=("$local_sha")
        fi
    done
fi

if [ "${#push_shas[@]}" -eq 0 ]; then
    exit 0
fi

remove_pre_push_worktree() {
    local wt=$1
    if [ -n "$wt" ] && [ -d "$wt" ]; then
        git -C "$repo_root" worktree remove -f "$wt" 2>/dev/null \
            || rm -rf "$wt"
    fi
}

cleanup() {
    remove_pre_push_worktree "$wt"
    wt=""
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# Run the How-to subset for $1 (preset) in a single hvt_test process.
# ctest spawns hvt_test once per test case, paying process and GPU-context
# startup hundreds of times — very slow on macOS — so it is not used here.
run_howto_tests() {
    local preset=$1
    local test_bin="build/$preset/bin/hvt_test"
    local -a sanitizer_env=()

    if [ ! -x "$test_bin" ]; then
        echo "pre-push: $test_bin not found after a successful build — push aborted" >&2
        return 1
    fi

    # Keep in sync with the `environment` blocks in CMakePresets.json: CMake
    # applies those only to its own invocations, not to this direct run.
    case "$preset" in
        asan)  sanitizer_env=(ASAN_OPTIONS="halt_on_error=1:abort_on_error=1:print_stacktrace=1") ;;
        ubsan) sanitizer_env=(UBSAN_OPTIONS="halt_on_error=1:abort_on_error=1:print_stacktrace=1") ;;
    esac

    # A filter that matches nothing (e.g. a renamed suite) runs 0 tests and
    # still exits 0 — fail instead of reporting a false pass.
    local matched
    matched=$(env ${sanitizer_env[@]+"${sanitizer_env[@]}"} "$test_bin" --gtest_list_tests \
        --gtest_filter="$TEST_GTEST_FILTER" | grep -c '^  ')
    if [ "$matched" -eq 0 ]; then
        echo "pre-push: filter '$TEST_GTEST_FILTER' matched no tests for preset '$preset' — push aborted" >&2
        return 1
    fi

    env ${sanitizer_env[@]+"${sanitizer_env[@]}"} "$test_bin" --gtest_brief=1 --gtest_filter="$TEST_GTEST_FILTER"
}

run_lean_presets() {
    for preset in "${PRESETS[@]}"; do
        echo "pre-push: configuring preset '$preset'"
        if ! cmake --preset "$preset"; then
            echo "pre-push: configure failed for preset '$preset' — push aborted" \
                "(bypass with: git push --no-verify)" >&2
            return 1
        fi

        echo "pre-push: building preset '$preset'"
        if ! cmake --build --preset "$preset"; then
            echo "pre-push: build failed for preset '$preset' — push aborted" \
                "(bypass with: git push --no-verify)" >&2
            return 1
        fi

        if [ "$SKIP_TESTS" != "1" ]; then
            case " $TEST_PRESETS " in
                *" $preset "*)
                    echo "pre-push: running How-to tests for preset '$preset' (filter: $TEST_GTEST_FILTER)"
                    if ! run_howto_tests "$preset"; then
                        echo "pre-push: tests failed for preset '$preset' — push aborted" \
                            "(bypass with: git push --no-verify)" >&2
                        return 1
                    fi
                    ;;
            esac
        fi
    done
    return 0
}

# Build at $1 (full commit sha) when HEAD is that commit and the tree is clean;
# otherwise use a detached worktree so uncommitted edits or another branch
# checkout cannot skew the result.
needs_isolated_worktree() {
    local sha=$1
    if [ -n "$(git -C "$repo_root" status --porcelain)" ]; then
        return 0
    fi
    local head
    head=$(git -C "$repo_root" rev-parse HEAD)
    [ "$head" != "$sha" ]
}

for local_sha in "${push_shas[@]}"; do
    if ! sha=$(git -C "$repo_root" rev-parse --verify "$local_sha^{commit}" 2>/dev/null); then
        echo "pre-push: unknown commit $local_sha — push aborted" >&2
        exit 1
    fi

    short_sha=${sha:0:12}
    build_dir=$repo_root

    if needs_isolated_worktree "$sha"; then
        wt="${git_dir}/pre-push-worktree-${sha}"
        remove_pre_push_worktree "$wt"
        if ! git -C "$repo_root" worktree add --detach "$wt" "$sha" >&2; then
            echo "pre-push: failed to check out $short_sha for validation — push aborted" \
                "(bypass with: git push --no-verify)" >&2
            exit 1
        fi
        build_dir=$wt
        # `git worktree add` does not populate submodules; reuse the main
        # checkout's vcpkg instead of cloning a second copy per push.
        if [ -z "${VCPKG_ROOT:-}" ] && [ -d "$repo_root/externals/vcpkg/ports" ]; then
            export VCPKG_ROOT="$repo_root/externals/vcpkg"
        fi
        echo "pre-push: validating commit $short_sha (detached worktree)"
    else
        echo "pre-push: validating commit $short_sha (current checkout)"
    fi

    if ! ( cd "$build_dir" && run_lean_presets ); then
        exit 1
    fi

    cleanup
done

echo "pre-push: all lean presets passed"
exit 0
