--- The render pass shader of OutlinePrimIdsTask, derived from hdx's renderPassPickingShader.glslfx.
--- It writes the prim ID and, with instance isolation, discards the instances no target keeps and
--- writes the instanceId AOV.

#import $TOOLS/hdSt/shaders/renderPass.glslfx
#import $TOOLS/hdx/shaders/renderPass.glslfx

-- configuration
{
    "techniques": {
        "default": {
            "vertexShader" : {
                "source": [ "RenderPass.Camera",
                            "RenderPass.ApplyClipPlanes" ]
            },
            "postTessControlShader" : {
                "source": [ "RenderPass.Camera" ]
            },
            "postTessVertexShader" : {
                "source": [ "RenderPass.Camera",
                            "RenderPass.ApplyClipPlanes" ]
            },
            "tessControlShader" : {
                "source": [ "RenderPass.Camera" ]
            },
            "tessEvalShader" : {
                "source": [ "RenderPass.Camera",
                            "RenderPass.ApplyClipPlanes" ]
            },
            "geometryShader" : {
                "source": [ "RenderPass.Camera",
                            "RenderPass.ApplyClipPlanes" ]
            },
            "fragmentShader" : {
                "source": [ "RenderPass.Camera",
                            "RenderPass.CameraFS",
                            "RenderPass.NoSelection",
                            "RenderPass.NoColorOverrides",
                            "Nomad.ShallowPick" ]
            }
        }
    }
}

-- layout Nomad.ShallowPick

[
    ["out", "int", "primIdOut"],
    ["out", "int", "instanceIdOut"],
    ["out", "int", "elementIdOut"],
    ["out", "int", "edgeIdOut"],
    ["out", "int", "pointIdOut"],
    ["out", "vec4", "neyeOut"]
]

-- glsl Nomad.ShallowPick

vec4 IntToVec4(int id)
{
    return vec4(((id >>  0) & 0xff) / 255.0,
                ((id >>  8) & 0xff) / 255.0,
                ((id >> 16) & 0xff) / 255.0,
                ((id >> 24) & 0xff) / 255.0);
}

// Fwd declare necessary methods to determine the subprim id of a fragment.
FORWARD_DECL(int GetElementID()); // generated via codeGen
FORWARD_DECL(int GetPrimitiveEdgeId()); // defined in edgeId.glslfx, or generated via codeGen
FORWARD_DECL(int GetPointId()); // defined in pointId.glslfx

#if defined(HD_HAS_hvtOutlineTargets)
// Outline instance isolation. hvtOutlineTargets is bound by OutlinePrimIdsTask only while some
// rprim is restricted to instances; without it this code is not compiled. Encoding (see
// _EncodeTargets in outlinePrimIdsTask.cpp):
//   [0] min prim ID, [1] prim ID count N,
//   [2 + primId - min] = 0 (not restricted, draw whole) or record offset.
//   record: [target count], then per target [bucket bits][level count], then per level
//           [level][index count][sorted instancer-wide instance indices].
// A target keeps a fragment when, at each of the target's levels, its instance index
// GetDrawingCoord().instanceIndex[level + 1] is one of the listed indices; a target with no level
// keeps every fragment. Bucket bits: selected = 1, lead = 2, hover = 4. A fragment is drawn when
// a selected or hover target keeps it; lead targets only recolor.
//
// The instanceId output carries, for the fragments of restricted rprims, (instance << 3) | the
// bucket bits of the targets that keep it, and -1 elsewhere. instance is the global instance ID
// (instanceIndex[0]) modulo 2^28, so that the value stays positive, or 0 for fragments a target
// with no level keeps. The mask colors restricted rprims from the bucket bits, and draws an edge
// where the value differs between two pixels of one prim ID: the instances of a restricted rprim
// are outlined one by one, while the ones kept whole share one outline per bucket combination, as
// rprims drawn whole do. Two instances whose global IDs differ by a multiple of 2^28 share a value,
// so no edge is drawn between them where they touch.

bool HvtOutlineHasIndex(int first, int count, int value)
{
    int lo = first;
    int hi = first + count - 1;
    while (lo <= hi)
    {
        int mid = lo + (hi - lo) / 2;
        int v = HdGet_hvtOutlineTargets(mid);
        if (v == value)
        {
            return true;
        }
        if (v < value)
        {
            lo = mid + 1;
        }
        else
        {
            hi = mid - 1;
        }
    }
    return false;
}

// The offset of the rprim's record, or 0 when the rprim is drawn whole.
int HvtOutlineGetRecord(int primId)
{
    int slot = primId - HdGet_hvtOutlineTargets(0);
    if (slot < 0 || slot >= HdGet_hvtOutlineTargets(1))
    {
        return 0;
    }
    return HdGet_hvtOutlineTargets(2 + slot);
}

// Set in the result of HvtOutlineRecordBuckets when a selected or hover target with no level keeps
// the fragment. Above the three bucket bits.
#define HVT_OUTLINE_KEPT_WHOLE 8

// The bucket bits of the targets of the record at offset that keep this fragment, or 0 when none
// does, plus HVT_OUTLINE_KEPT_WHOLE.
int HvtOutlineRecordBuckets(int offset)
{
    hd_drawingCoord dc = GetDrawingCoord();
    int buckets = 0;
    int targetCount = HdGet_hvtOutlineTargets(offset);
    offset += 1;
    for (int t = 0; t < targetCount; ++t)
    {
        int targetBuckets = HdGet_hvtOutlineTargets(offset);
        int levelCount = HdGet_hvtOutlineTargets(offset + 1);
        offset += 2;
        bool kept = true;
        for (int l = 0; l < levelCount; ++l)
        {
            int level = HdGet_hvtOutlineTargets(offset);
            int count = HdGet_hvtOutlineTargets(offset + 1);
            // The level is valid for this rprim by construction; the bound check only keeps the
            // array access in range if the encoding and the shader permutation ever disagree.
            if (kept)
            {
                kept = level < HD_INSTANCER_NUM_LEVELS
                    && HvtOutlineHasIndex(offset + 2, count, dc.instanceIndex[level + 1]);
            }
            offset += 2 + count;
        }
        if (kept)
        {
            buckets |= targetBuckets;
            // Lead targets do not keep fragments, so they do not make one kept whole.
            if (levelCount == 0 && targetBuckets != 2)
            {
                buckets |= HVT_OUTLINE_KEPT_WHOLE;
            }
        }
    }
    return buckets;
}
#endif

void RenderOutput(vec4 Peye, vec3 Neye, vec4 color, vec4 patchCoord)
{
#if defined(HD_HAS_hvtOutlineTargets)
    // Discarded before any output is written: the fragment leaves neither an ID nor a depth, so a
    // non-target instance in front of a target one cannot hide it.
    int hvtRecord = HvtOutlineGetRecord(HdGet_primID());
    int hvtBuckets = hvtRecord != 0 ? HvtOutlineRecordBuckets(hvtRecord) : 0;
    // Only a selected (1) or hover (4) target keeps a fragment.
    if (hvtRecord != 0 && (hvtBuckets & 5) == 0)
    {
        discard;
    }

    // Instance and bucket bits, for the mask's per-instance colors and edges (see above). The
    // instance is masked to 28 bits so that the shift cannot reach the sign bit.
    int hvtInstance = (hvtBuckets & HVT_OUTLINE_KEPT_WHOLE) != 0
        ? 0 : (GetDrawingCoord().instanceIndex[0] & 0x0FFFFFFF);
    instanceIdOut = hvtRecord != 0 ? (hvtInstance << 3) | (hvtBuckets & 7) : -1;
#else
    // Without isolation no instance is told apart: the instanceId AOV is not even bound.
    instanceIdOut = -1;
#endif

    primIdOut = HdGet_primID();

    elementIdOut = GetElementID();
    edgeIdOut = GetPrimitiveEdgeId();
    pointIdOut = GetPointId();
    
    neyeOut = IntToVec4(hd_vec4_2_10_10_10_set(vec4(Neye,0)));
}