-- configuration
{
    "techniques": {
        "default": {
            "GreyScale::Fragment": {
                "source": [ "GreyScale.Fragment" ]
            }
        }
    }
}

-- glsl GreyScale.Fragment

float GreyScaleLuma(vec3 rgb)
{
    return dot(rgb, vec3(0.299, 0.587, 0.114));
}

void main(void)
{
    vec4 rgba = HgiGet_colorIn(uvOut);
    float luma = GreyScaleLuma(rgba.rgb);
    hd_FragColor = vec4(luma, luma, luma, rgba.a);
}
