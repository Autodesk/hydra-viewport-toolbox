-- configuration
{
    "techniques": {
        "default": {
            "Bloom::Fragment": {
                "source": [ "Bloom.Fragment" ]
            }
        }
    }
}

-- glsl Bloom.Fragment

float BloomLuma(vec3 rgb)
{
    return dot(rgb, vec3(0.2126, 0.7152, 0.0722));
}

void main(void)
{
    vec4 sceneColor = HgiGet_colorIn(uvOut);
    vec2 invSize = vec2(1.0) / max(screenSize, vec2(1.0));

    vec3 bloomAccum = vec3(0.0);
    float weightSum = 0.0;

    for (int x = -1; x <= 1; ++x)
    {
        for (int y = -1; y <= 1; ++y)
        {
            vec2 offset = vec2(float(x), float(y)) * invSize * blurRadius;
            vec3 sampleRgb = HgiGet_colorIn(uvOut + offset).rgb;
            float bright = max(BloomLuma(sampleRgb) - threshold, 0.0);
            bloomAccum += sampleRgb * bright;
            weightSum += 1.0;
        }
    }

    vec3 bloom = bloomAccum / max(weightSum, 1.0);
    hd_FragColor = vec4(sceneColor.rgb + bloom * intensity, sceneColor.a);
}
