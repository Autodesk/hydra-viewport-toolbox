{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cmake --preset:*)",
      "Bash(cmake --build:*)",
      "Bash(cmake --workflow:*)",
      "Bash(ctest --preset:*)",
      "Bash(./build/*/bin/hvt_test:*)",
      "Bash(clang-format:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ]
  }
}
